{
  "mcpServers": {
    "cco": {
      "command": "cco",
      "args": ["mcp", "serve"],
      "env": {}
    }
  },
  "tools": {
    "knowledge_search": {
      "description": "Search the CCO knowledge base for relevant context and decisions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query to find relevant knowledge entries"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of results to return (default: 10)",
            "default": 10
          },
          "type": {
            "type": "string",
            "description": "Filter by knowledge type: 'decision', 'edit', 'status', 'completion', 'architecture', 'test', 'bug', or 'optimization'",
            "enum": ["decision", "edit", "status", "completion", "architecture", "test", "bug", "optimization"]
          }
        },
        "required": ["query"]
      }
    },
    "knowledge_store": {
      "description": "Store knowledge entries in the CCO knowledge base for agent coordination",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The knowledge content to store"
          },
          "type": {
            "type": "string",
            "description": "Type of knowledge: 'decision', 'edit', 'status', 'completion', 'architecture', 'test', 'bug', or 'optimization'",
            "enum": ["decision", "edit", "status", "completion", "architecture", "test", "bug", "optimization"]
          },
          "agent": {
            "type": "string",
            "description": "Name of the agent storing this knowledge"
          },
          "metadata": {
            "type": "object",
            "description": "Optional metadata dictionary (e.g., file paths, line numbers, test names)",
            "additionalProperties": true
          }
        },
        "required": ["text", "type", "agent"]
      }
    },
    "get_context": {
      "description": "Get contextual information for an agent type or specific issue",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_type": {
            "type": "string",
            "description": "Type of agent context needed (e.g., 'architect', 'tdd', 'security', 'backend', 'frontend')"
          },
          "issue_id": {
            "type": "string",
            "description": "Optional specific issue ID to get context for"
          }
        },
        "required": ["agent_type"]
      }
    },
    "list_agents": {
      "description": "List available agents filtered by model tier or category",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Filter by model: 'opus-4-1', 'sonnet-4-5', or 'haiku-4-5'",
            "enum": ["opus-4-1", "sonnet-4-5", "haiku-4-5"]
          },
          "category": {
            "type": "string",
            "description": "Filter by category: 'development', 'infrastructure', 'quality-assurance', 'documentation', 'research', or 'support'",
            "enum": ["development", "infrastructure", "quality-assurance", "documentation", "research", "support"]
          }
        }
      }
    },
    "session_start": {
      "description": "Initialize a new CCO session for coordinating agent work",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Unique identifier for the session"
          },
          "project_id": {
            "type": "string",
            "description": "Project identifier this session is for"
          }
        },
        "required": ["session_id", "project_id"]
      }
    },
    "pre_compaction": {
      "description": "Prepare the knowledge base before compaction to preserve important context",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session identifier for compaction"
          },
          "project_id": {
            "type": "string",
            "description": "Project identifier for compaction"
          }
        },
        "required": ["session_id", "project_id"]
      }
    },
    "codex_status": {
      "description": "Check if OpenAI Codex CLI is available and authenticated for external code review",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "chunk_search": {
      "description": "Search conversation chunks for detailed context from past sessions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query text"
          },
          "limit": {
            "type": "number",
            "description": "Max results (default: 5)"
          },
          "session_id": {
            "type": "string",
            "description": "Optional session ID filter"
          },
          "project_id": {
            "type": "string",
            "description": "Optional project ID filter"
          }
        },
        "required": ["query"]
      }
    },
    "knowledge_recall": {
      "description": "Combined search across insights and conversation chunks using hybrid BM25+vector search. Supports multi-hop recursive retrieval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query"
          },
          "limit": {
            "type": "number",
            "description": "Max results per source (default: 5)"
          },
          "max_hops": {
            "type": "number",
            "description": "Number of recursive retrieval hops (default: 3, max: 3)"
          },
          "project_id": {
            "type": "string",
            "description": "Optional project ID filter"
          }
        },
        "required": ["query"]
      }
    },
    "knowledge_lifecycle_status": {
      "description": "Get lifecycle zone distribution and immunity statistics",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    "knowledge_graph_query": {
      "description": "Query the knowledge graph to explore relationships between decisions, files, patterns, and agents",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Action: 'search', 'traverse', 'path', 'stats'",
            "enum": ["search", "traverse", "path", "stats"]
          },
          "name": {
            "type": "string",
            "description": "For search: node name to find"
          },
          "node_id": {
            "type": "string",
            "description": "For traverse: starting node ID"
          },
          "from_id": {
            "type": "string",
            "description": "For path: source node ID"
          },
          "to_id": {
            "type": "string",
            "description": "For path: target node ID"
          },
          "depth": {
            "type": "number",
            "description": "For traverse: max depth (default: 2)"
          }
        },
        "required": ["action"]
      }
    },
    "task_create": {
      "description": "Create a new task in the daemon's task DAG engine for tracking work items and dependencies",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Task title"
          },
          "description": {
            "type": "string",
            "description": "Detailed task description"
          },
          "parent_id": {
            "type": "string",
            "description": "Optional parent task ID for subtasks"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Task IDs this depends on"
          },
          "agent": {
            "type": "string",
            "description": "Agent name to assign"
          },
          "project_id": {
            "type": "string",
            "description": "Project ID"
          }
        },
        "required": ["title"]
      }
    },
    "task_status": {
      "description": "Get the status and details of a task by ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task ID to look up"
          }
        },
        "required": ["task_id"]
      }
    },
    "task_list": {
      "description": "List tasks, optionally filtered by project",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Optional project ID filter"
          },
          "limit": {
            "type": "number",
            "description": "Max results (default: 20)"
          }
        }
      }
    },
    "agent_performance_stats": {
      "description": "Get performance metrics and trust scores for all agents, or a specific agent",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent_name": {
            "type": "string",
            "description": "Optional specific agent name"
          }
        }
      }
    },
    "code_search": {
      "description": "Search the project code index for symbols, functions, structs, and documentation comments",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text — symbol names, function signatures, struct names, or documentation keywords"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results to return (default: 20, max: 200)"
          }
        },
        "required": ["query"]
      }
    }
  }
}
